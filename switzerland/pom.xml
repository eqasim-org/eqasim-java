<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>switzerland</artifactId>

	<parent>
		<groupId>org.eqasim</groupId>
		<artifactId>eqasim</artifactId>
		<version>2.0.0</version> <!-- x-release-please-version -->
		<relativePath>../pom.xml</relativePath>
	</parent>

	<dependencies>
		<!-- Already supplied by MATSim; used directly for the temporary scenario-attribute archive. -->
		<dependency>
			<groupId>org.lz4</groupId>
			<artifactId>lz4-java</artifactId>
			<version>1.8.0</version>
		</dependency>
		<!-- Already used by GeoPackage; declared directly for the PT cache's indexed binary store. -->
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<version>3.41.2.2</version>
		</dependency>
		<dependency>
			<groupId>org.eqasim</groupId>
			<artifactId>core</artifactId>
			<version>2.0.0</version> <!-- x-release-please-version -->
		</dependency>
	</dependencies>

	<properties>
		<!-- Override for a different checkout location or Cargo installation. -->
		<rust.router.project>${project.basedir}/../../MultiModalRouter</rust.router.project>
		<rust.router.library></rust.router.library>
		<rust.router.version>v0.2.0</rust.router.version>
		<rust.router.bundle.skip>true</rust.router.bundle.skip>
		<cargo.executable>cargo</cargo.executable>
	</properties>
	<build>
		<resources>
			<resource><directory>src/main/resources</directory></resource>
		</resources>
		<plugins>
			<!-- Runs after Java compilation so packaging reuses the same installer as the application. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
				<executions><execution><id>bundle-rust-pt-router</id><phase>process-classes</phase><goals><goal>java</goal></goals>
					<configuration>
						<skip>${rust.router.bundle.skip}</skip>
						<mainClass>org.eqasim.switzerland.ch_cmdp.rustRouting.RustRouterBundler</mainClass>
						<cleanupDaemonThreads>false</cleanupDaemonThreads>
						<arguments>
							<argument>--output=${project.build.outputDirectory}</argument>
							<argument>--source=${rust.router.project}</argument>
							<argument>--library=${rust.router.library}</argument>
							<argument>--version=${rust.router.version}</argument>
						</arguments>
						<systemProperties><systemProperty><key>eqasim.rust.cargo</key><value>${cargo.executable}</value></systemProperty></systemProperties>
					</configuration>
				</execution></executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Compatibility profile: standalone now bundles the native router by default. -->
		<profile>
			<id>rust-router</id>
			<properties><rust.router.bundle.skip>false</rust.router.bundle.skip></properties>
		</profile>

		<profile>
			<id>standalone</id>
			<properties><rust.router.bundle.skip>false</rust.router.bundle.skip></properties>
			<build>
				<finalName>switzerland</finalName>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-shade-plugin</artifactId>
						<version>3.6.0</version>
						<executions>
							<execution>
								<phase>package</phase>
								<goals>
									<goal>shade</goal>
								</goals>
								<configuration>
									<transformers>
										<transformer
											implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
										<transformer
											implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
											<manifestEntries>
												<Implementation-Vendor>Eqasim</Implementation-Vendor>
												<Implementation-Version>
													${parent.groupId}</Implementation-Version>
												<Main-Class>org.eqasim.switzerland.ch_cmdp.RunSimulation</Main-Class>
												<Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
												<Add-Opens>java.base/jdk.internal.misc java.base/java.lang.invoke</Add-Opens>
											</manifestEntries>
										</transformer>
									</transformers>
									<filters>
										<filter>
											<artifact>*:*</artifact>
											<excludes>
												<exclude>META-INF/*.SF</exclude>
												<exclude>META-INF/*.DSA</exclude>
												<exclude>META-INF/*.RSA</exclude>
											</excludes>
										</filter>
									</filters>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
